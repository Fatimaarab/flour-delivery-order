# ─────────────────────────────────────────────────────────────────────
#  تنظیمات سامانه حواله آرد
#
#  این فایل را کپی کنید و نامش را .env بگذارید، سپس مقادیر زیر را
#  تنظیم کنید. سامانه بدون تنظیم درست JWT_SECRET اجرا نمی‌شود.
# ─────────────────────────────────────────────────────────────────────

# مسیر فایل دیتابیس SQLite (بکاپ = کپی همین یک فایل)
DATABASE_URL="file:./data/ard.db"

# 🔴 کلید امضای نشست کاربران و کد QR روی برگه‌های حواله.
#
# این مقدار را حتماً عوض کنید. با همین کلید، برگه‌های حواله امضا
# می‌شوند؛ اگر کسی آن را بداند می‌تواند برگه جعلی بسازد.
#
# برای ساخت یک کلید امن، این دستور را در همین پوشه اجرا کنید و
# خروجی‌اش را اینجا بگذارید:
#
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
JWT_SECRET=""

# پورت سرور
PORT=4000

# پوشه‌ای که بکاپ‌ها در آن ساخته می‌شوند
# ترجیحاً روی درایوی غیر از درایو دیتابیس، یا روی فلش USB
BACKUP_DIR="backups"

# چند نسخه بکاپ نگه داشته شود (قدیمی‌ترها خودکار پاک می‌شوند)
BACKUP_KEEP=30

# نسخه دوم بکاپ روی کامپیوتر یا دیسک دیگر، مثلاً "\\\\PC2\\ArdBackup" یا "E:\\ArdBackup".
# بکاپ خودکار هر شب گرفته می‌شود و همین‌جا هم کپی می‌شود.
BACKUP_COPY_DIR=""

# ─── پیامک ───────────────────────────────────────────────────────────
# off  = خاموش (پیش‌فرض)
# test = حالت آزمایشی: پیامک‌ها ثبت می‌شوند ولی واقعاً فرستاده نمی‌شوند
SMS_PROVIDER="off"

# شماره موبایل مدیر یا مدیران کارخانه؛ با ویرگول جدا کنید
# نمونه: "09151234567,09121234567"
SMS_MANAGER_NUMBERS=""
